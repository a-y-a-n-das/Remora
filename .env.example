# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# S3
S3_BUCKET=remora-memories

# Upload Limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=5
RATE_LIMIT_UPLOADS=20
MAX_TOTAL_STORAGE_GB=10

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# CORS
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=INFO