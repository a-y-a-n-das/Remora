# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# S3
S3_BUCKET=remora-memory

# Upload Limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_REQUEST=5
RATE_LIMIT_UPLOADS=20
MAX_TOTAL_STORAGE_GB=10

# SQS
SQS_QUEUE_URL=
SQS_MAX_MESSAGES=1
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# Textract
TEXTRACT_MAX_RETRIES=3

# Bedrock
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-image-v1
BEDROCK_EMBEDDING_DIMENSION=1024
BEDROCK_MAX_RETRIES=3

# Voyage AI
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multimodal-3
VOYAGE_EMBEDDING_DIMENSION=1024
VOYAGE_MAX_RETRIES=3
VOYAGE_TIMEOUT_SECONDS=30.0

# S3 Vectors
S3_VECTORS_BUCKET=
S3_VECTORS_INDEX=memories
S3_VECTORS_DIMENSION=1024
S3_VECTORS_DISTANCE_METRIC=cosine
S3_VECTORS_MAX_RETRIES=3

# Neon PostgreSQL
NEON_DATABASE_URL=

# NVIDIA Nemotron
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-ultra
NEMOTRON_MAX_RETRIES=3
NEMOTRON_TIMEOUT_SECONDS=60.0

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# CORS
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=INFO